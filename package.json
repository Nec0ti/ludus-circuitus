    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/cli": "^4.3.5",
    "daisyui": "^5.8.2",
    "tailwindcss": "^4.3.5"
  }
}
